{
  "name": "aila",
  "version": "1.0.0",
  "description": "AI Life Assistant - مساعد الحياة الذكي",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./core": {
      "import": "./dist/core/index.js",
      "types": "./dist/core/index.d.ts"
    },
    "./providers": {
      "import": "./dist/providers/index.js",
      "types": "./dist/providers/index.d.ts"
    },
    "./memory": {
      "import": "./dist/memory/index.js",
      "types": "./dist/memory/index.d.ts"
    },
    "./tools": {
      "import": "./dist/tools/index.js",
      "types": "./dist/tools/index.d.ts"
    },
    "./voice": {
      "import": "./dist/voice/index.js",
      "types": "./dist/voice/index.d.ts"
    },
    "./security": {
      "import": "./dist/security/index.js",
      "types": "./dist/security/index.d.ts"
    },
    "./ui": {
      "import": "./dist/ui/index.js",
      "types": "./dist/ui/index.d.ts"
    },
    "./iot": {
      "import": "./dist/iot/index.js",
      "types": "./dist/iot/index.d.ts"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:watch": "tsc --watch & vite build --watch",
    "preview": "vite preview",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "docs": "typedoc --theme minimal --out docs src"
  },
  "keywords": [
    "ai",
    "assistant",
    "jarvis",
    "voice",
    "chatbot",
    "agent",
    "productivity",
    "personal-assistant",
    "arabic",
    "rtl",
    "typescript",
    "web-components",
    "lit"
  ],
  "author": "AILA Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aila-ai/aila.git"
  },
  "bugs": {
    "url": "https://github.com/aila-ai/aila/issues"
  },
  "homepage": "https://aila-ai.github.io",
  "devDependencies": {
    "@playwright/test": "^1.41.0",
    "@types/node": "^20.11.0",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "@vitest/coverage-v8": "^1.2.2",
    "@vitest/ui": "^1.2.2",
    "eslint": "^8.56.0",
    "eslint-plugin-lit": "^1.11.0",
    "eslint-plugin-wc": "^2.0.0",
    "playwright": "^1.41.0",
    "prettier": "^3.2.4",
    "typedoc": "^0.25.7",
    "typescript": "^5.3.3",
    "vite": "^5.0.12",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "^1.2.2"
  },
  "dependencies": {
    "idb": "^8.0.0",
    "lit": "^3.1.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "uuid": "^9.0.1",
    "zustand": "^4.5.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "browser": ">=90.0.0"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 2 Edge versions"
  ]
}
